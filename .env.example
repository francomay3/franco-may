# Maps Embed API key for the admin place page (satellite map and Street View).
# Restrict it to the Maps Embed API and to this site's domains.
GOOGLE_MAPS_EMBED_API_KEY=

# Brave Search API key. Used server-side to render search links on the admin place page.
BRAVE_SEARCH_API_KEY=

# SMTP Configuration for Contact Form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Note: For Gmail, you'll need to:
# 1. Enable 2-factor authentication
# 2. Generate an App Password (not your regular password)
# 3. Use that App Password as SMTP_PASS
